# =============================================================================
# Ders Defteri — Ortam Değişkenleri Şablonu
# =============================================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
#
# UYARI: .env dosyasını asla git'e eklemeyin! (.gitignore'a dahildir)
# Bu dosya (.env.example) güvenle commit edilebilir.
#
# Expo, "EXPO_PUBLIC_" önekine sahip değişkenleri uygulama kodundan
# process.env.EXPO_PUBLIC_XXX şeklinde erişilebilir kılar.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
# Supabase Dashboard > Project Settings > API bölümünden alın.

# Projenizin benzersiz URL'i (örn: https://abcdefghijkl.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Genel (public) API anahtarı — istemci tarafında kullanmak güvenlidir
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# UYGULAMA (Opsiyonel)
# -----------------------------------------------------------------------------

# Ortam: development | staging | production
APP_ENV=development

# Uygulama versiyonu (package.json ile senkron tutun)
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# NOTLAR
# -----------------------------------------------------------------------------
# - Service Role Key'i (gizli anahtar) ASLA ön yüzde kullanmayın.
# - Tüm hassas değerleri .env dosyasında tutun, kaynak koda yazmayın.
# - EAS Build kullanıyorsanız: eas secret:create --scope project --name KEY --value VALUE
